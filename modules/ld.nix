{
  inputs,
  config,
  pkgs,
  ...
}:
{
  programs.nix-ld.enable = true;
  programs.nix-ld.libraries = with pkgs; [
    webkitgtk_4_1
    libsoup_3
    gtk3
    pango
    cairo
    glib
    gdk-pixbuf
    atk
    adwaita-icon-theme
    harfbuzz
    freetype
    fontconfig
    dbus
    zlib
    xorg.libX11
    xorg.libXcursor
    xorg.libXrandr
    xorg.libXi
    xorg.libXext
    xorg.libXdamage
    xorg.libXfixes
    xorg.libXcomposite
    xorg.libXrender
    xorg.libXtst
    libGL
  ];
}
